# =====================================================================
# Configuration du Système de Détection d'Intrusion par Caméra USB
# =====================================================================

# --- Options générales ---
# TEST_MODE=false
# CAMERA_INDEX=0
# CAMERA_RESOLUTION=720p   # Valeurs possibles : 480p, 720p, 1080p, ou 1920x1080
# PHOTO_DELAY=0.5          # Retard en secondes de la photo d'alerte initiale
# MIN_AREA=1200
# OUTPUT_DIR=./recordings
# KEEP_VIDEOS=true

# --- Masquage & Zones d'exclusion (pour éviter les faux positifs sous la porte) ---
# AUTO_DOOR=true           # Détecte automatiquement la porte et masque les 20% du bas
# EXCLUDE_ZONES=0,75,35,100 # Format: x1,y1,x2,y2 en % de l'image (plusieurs zones avec ';')

# --- Contrôle à distance Telegram ---
# 1. Ouvrez Telegram et cherchez @BotFather
# 2. Envoyez la commande /newbot et suivez les instructions pour obtenir votre TOKEN
# 3. Collez votre token ci-dessous :
TELEGRAM_BOT_TOKEN=
# Laissez vide au début : le programme associera automatiquement votre compte
# dès que vous lui enverrez /start sur Telegram !
TELEGRAM_CHAT_ID=

# --- Configuration E-mail / SMTP ---
# Exemple pour Gmail :
#   Hôte : smtp.gmail.com
#   Port : 587 (avec STARTTLS) ou 465 (avec SSL)
#   Pour Gmail, utilisez impérativement un "Mot de passe d'application"
#   généré depuis votre compte Google (Sécurité > Validation en deux étapes > Mots de passe d'application).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_adresse@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application_16_caracteres
SMTP_USE_SSL=false

# Expéditeur et destinataire
EMAIL_FROM=votre_adresse@gmail.com
EMAIL_TO=destinataire_alerte@gmail.com

# Activer pour afficher les e-mails dans la console au lieu de contacter le serveur SMTP réel
MOCK_EMAIL=false
